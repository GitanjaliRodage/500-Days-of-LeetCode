
class Solution {
    public long countNonDecreasingSubarrays(int[] nums, int k) {
        int n = nums.length;
        int LOG = 17;

        while ((1 << LOG) <= n) LOG++;

        int[] next = new int[n];
        int[] stack = new int[n];
        int top = -1;

        // Next Greater Element
        for (int i = n - 1; i >= 0; i--) {
            while (top >= 0 && nums[stack[top]] <= nums[i]) {
                top--;
            }

            next[i] = (top == -1) ? n : stack[top];
            stack[++top] = i;
        }

        int[][] jump = new int[LOG][n];
        long[][] sum = new long[LOG][n];

        for (int i = 0; i < n; i++) {
            jump[0][i] = next[i];
            sum[0][i] = (long) nums[i] * (next[i] - i);
        }

        // Binary Lifting
        for (int j = 1; j < LOG; j++) {
            for (int i = 0; i < n; i++) {
                int mid = jump[j - 1][i];

                if (mid < n) {
                    jump[j][i] = jump[j - 1][mid];
                    sum[j][i] = sum[j - 1][i]
                              + sum[j - 1][mid];
                } else {
                    jump[j][i] = n;
                    sum[j][i] = sum[j - 1][i];
                }
            }
        }

        long[] prefix = new long[n + 1];

        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + nums[i];
        }

        // Calculate sum of prefix maximums
        long answer = 0;
        int left = 0;

        for (int right = 0; right < n; right++) {
            while (left <= right) {
                long maxSum = 0;
                int cur = left;

                for (int j = LOG - 1; j >= 0; j--) {
                    if (jump[j][cur] <= right + 1) {
                        maxSum += sum[j][cur];
                        cur = jump[j][cur];
                    }
                }

                if (cur <= right) {
                    maxSum += (long) nums[cur] * (right - cur + 1);
                }

                long operations = maxSum -
                    (prefix[right + 1] - prefix[left]);

                if (operations <= k) {
                    break;
                }

                left++;
            }

            answer += right - left + 1;
        }

        return answer;
    }
}
