
import java.util.*;

class Solution {
    private List<Integer>[] adj;
    private int[] tin, tout, depth;
    private int[][] up;
    private int[] bit;
    private char[] chars;
    private int timer;
    private int LOG;

    public boolean[] palindromePath(int n, int[][] edges, String s,
                                    String[] queries) {
        adj = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
        }

        for (int[] e : edges) {
            adj[e[0]].add(e[1]);
            adj[e[1]].add(e[0]);
        }

        chars = s.toCharArray();
        tin = new int[n];
        tout = new int[n];
        depth = new int[n];

        LOG = 1;
        while ((1 << LOG) <= n) LOG++;

        up = new int[LOG][n];
        bit = new int[n + 2];
        timer = 0;

        dfs(0, 0);

        for (int i = 0; i < n; i++) {
            add(tin[i], 1 << (chars[i] - 'a'));
            add(tout[i] + 1, 1 << (chars[i] - 'a'));
        }

        List<Boolean> result = new ArrayList<>();

        for (String q : queries) {
            String[] p = q.split(" ");
            int u = Integer.parseInt(p[1]);

            if (p[0].equals("update")) {
                char c = p[2].charAt(0);

                if (chars[u] != c) {
                    int change = (1 << (chars[u] - 'a'))
                               ^ (1 << (c - 'a'));

                    add(tin[u], change);
                    add(tout[u] + 1, change);
                    chars[u] = c;
                }
            } else {
                int v = Integer.parseInt(p[2]);
                int lca = getLca(u, v);

                int mask = prefix(tin[u])
                         ^ prefix(tin[v])
                         ^ (1 << (chars[lca] - 'a'));

                result.add((mask & (mask - 1)) == 0);
            }
        }

        boolean[] ans = new boolean[result.size()];
        for (int i = 0; i < ans.length; i++) {
            ans[i] = result.get(i);
        }

        return ans;
    }

    private void dfs(int u, int parent) {
        tin[u] = ++timer;
        up[0][u] = parent;

        for (int j = 1; j < LOG; j++) {
            up[j][u] = up[j - 1][up[j - 1][u]];
        }

        for (int v : adj[u]) {
            if (v == parent) continue;
            depth[v] = depth[u] + 1;
            dfs(v, u);
        }

        tout[u] = timer;
    }

    private int getLca(int u, int v) {
        if (depth[u] < depth[v]) {
            int t = u;
            u = v;
            v = t;
        }

        int diff = depth[u] - depth[v];

        for (int j = 0; j < LOG; j++) {
            if ((diff & (1 << j)) != 0) {
                u = up[j][u];
            }
        }

        if (u == v) return u;

        for (int j = LOG - 1; j >= 0; j--) {
            if (up[j][u] != up[j][v]) {
                u = up[j][u];
                v = up[j][v];
            }
        }

        return up[0][u];
    }

    private void add(int i, int mask) {
        for (; i < bit.length; i += i & -i) {
            bit[i] ^= mask;
        }
    }

    private int prefix(int i) {
        int mask = 0;
        for (; i > 0; i -= i & -i) {
            mask ^= bit[i];
        }
        return mask;
    }
}
