class Solution {
    public int sumCounts(int[] nums) {
        int MOD = 1_000_000_007;
        int n = nums.length;
        long ans = 0;

        for (int i = 0; i < n; i++) {
            boolean[] seen = new boolean[100001];
            int distinct = 0;

            for (int j = i; j < n; j++) {
                if (!seen[nums[j]]) {
                    seen[nums[j]] = true;
                    distinct++;
                }

                ans = (ans + (long) distinct * distinct) % MOD;
            }
        }

        return (int) ans;
    }
}
