import java.util.Arrays;

class Solution {
    public long maxAlternatingSum(int[] nums) {
        Arrays.sort(nums);

        long sum = 0;
        int n = nums.length;

        for (int i = 0; i < n / 2; i++) {
            long x = nums[i];
            sum -= x * x;
        }

        for (int i = n / 2; i < n; i++) {
            long x = nums[i];
            sum += x * x;
        }

        return sum;
    }
}
