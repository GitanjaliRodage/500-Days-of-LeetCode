class Solution {
    public int minOperations(String s) {
        int n = s.length();

        boolean sorted = true;
        for (int i = 1; i < n; i++) {
            if (s.charAt(i) < s.charAt(i - 1)) {
                sorted = false;
                break;
            }
        }

        if (sorted) return 0;
        if (n == 2) return -1;

        if (n == 3) {
            return s.charAt(0) < s.charAt(2) ? 1 : -1;
        }

        char first = s.charAt(0);
        char last = s.charAt(n - 1);

        if (first < last) return 1;

        if (first > last) return 2;

        for (int i = 1; i < n - 1; i++) {
            if (s.charAt(i) != first) {
                return 2;
            }
        }

        return 3;
    }
}
