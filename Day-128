
import java.util.*;

class Solution {

    TreeMap<Integer, Integer> left = new TreeMap<>();
    TreeMap<Integer, Integer> right = new TreeMap<>();

    int ls, rs;
    long sumL, sumR;

    void addLeft(int v) {
        left.put(v, left.getOrDefault(v, 0) + 1);
        ls++;
        sumL += v;
    }

    void addRight(int v) {
        right.put(v, right.getOrDefault(v, 0) + 1);
        rs++;
        sumR += v;
    }

    void removeLeft(int v) {
        int c = left.get(v);
        if (c == 1) left.remove(v);
        else left.put(v, c - 1);

        ls--;
        sumL -= v;
    }

    void removeRight(int v) {
        int c = right.get(v);
        if (c == 1) right.remove(v);
        else right.put(v, c - 1);

        rs--;
        sumR -= v;
    }

    void balance() {
        while (ls > rs + 1) {
            int v = left.lastKey();
            removeLeft(v);
            addRight(v);
        }

        while (ls < rs) {
            int v = right.firstKey();
            removeRight(v);
            addLeft(v);
        }
    }

    void add(int v) {
        if (left.isEmpty() || v <= left.lastKey()) {
            addLeft(v);
        } else {
            addRight(v);
        }
        balance();
    }

    void remove(int v) {
        if (left.containsKey(v)) {
            removeLeft(v);
        } else {
            removeRight(v);
        }
        balance();
    }

    long getCost() {
        long median = left.lastKey();
        return median * ls - sumL + sumR - median * rs;
    }

    public long minOperations(int[] nums, int x, int k) {

        int n = nums.length;
        long[] cost = new long[n - x + 1];

        left.clear();
        right.clear();
        ls = rs = 0;
        sumL = sumR = 0;

        // Sliding window
        for (int i = 0; i < n; i++) {

            add(nums[i]);

            if (i >= x) {
                remove(nums[i - x]);
            }

            if (i >= x - 1) {
                cost[i - x + 1] = getCost();
            }
        }

        // DP
        long INF = Long.MAX_VALUE / 4;

        long[][] dp = new long[k + 1][n + 1];

        for (int j = 1; j <= k; j++) {
            Arrays.fill(dp[j], INF);
        }

        for (int j = 1; j <= k; j++) {

            for (int i = j * x; i <= n; i++) {

                // Skip current element
                dp[j][i] = dp[j][i - 1];

                // Select subarray ending at i-1
                if (dp[j - 1][i - x] != INF) {

                    dp[j][i] = Math.min(
                        dp[j][i],
                        dp[j - 1][i - x] + cost[i - x]
                    );
                }
            }
        }

        return dp[k][n];
    }
}
